@using TP1_Resto.ViewModels.Restaurants;

@model RestaurantVM
@{
    ViewData["Title"] = "Restaurants";
}

<h1>Restaurants</h1>
<div class="accordion" id="accordeon">
    @foreach(Restaurant resto in Model.restaurants)
    {
        <div class="accordion-item">
            <!--aria-controls doit avoir collapse et un chiffre en lettre, sinon ça marche pas, d'où la méthode au-dessus--->
            <h2 class="accordion-header">
                <button class="accordion-button @Model.IsFirstElementColl(resto)" type="button" data-bs-toggle="collapse" data-bs-target="#@Model.CollapseStr(resto)" aria-expanded="@Model.IsFirstElement(resto)" aria-controls="@Model.CollapseStr(resto)">
                    @resto.Nom
                </button>
            </h2>
            <!--id doit être la même chose que le aria-constrols associé (je crois)-->
            <div id="@Model.CollapseStr(resto)" class="accordion-collapse collapse @Model.IsFirstElementShow(resto)" data-bs-parent="#accordeon">
                <div class="accordion-body">
                    <table>
                        <tr>
                            <td>
                                <p><bold>Nom:</bold> @resto.Nom</p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <p><bold>Adresse:</bold> @resto.Adresse</p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <p><bold>Numéro de téléphone:</bold> @resto.Telephone</p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <p><bold>Cuisine:</bold> @resto.Cuisine</p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <p><bold>Note sur 5:</bold> @resto.Note</p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <p><bold>Ville:</bold> @resto.Ville</p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <p><bold>Nombre de plats offert:</bold> @resto.NbrPlats</p>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    }
</div>