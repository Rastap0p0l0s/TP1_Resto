@{
    List<Plat> listePlats = new List<Plat>();
    List<Restaurant> listeResto = new List<Restaurant>();
}

<!--Importer la liste des 3 meilleurs restos et les mettre dans le foreach-->
<!--Sinon Importer la liste de tous les restos ordoné par Note (best to last) et changer foreach pour for-->

<!--Restos-->
<h2>Meilleurs restaurants</h2>
<table>
    <tr>
        @foreach(Restaurant resto in listeResto)
        {
            <td>
                <div class="card" style="width: 18rem;">
                    <div class="card-body">
                        <h5 class="card-title">@resto.Nom</h5>
                        <p class="card-text">@resto.Cuisine</p>
                        <p class="card-text">@resto.Note</p>
                    </div>
                </div>
            </td>
        }
    </tr>
</table>

<!--Plats-->
<h2>Plats les moins chers</h2>
<table>
    <tr>
        @foreach (Plat plats in listePlats)
        {
            <td>
                <div class="card" style="width: 18rem;">
                    <img src="@plats.CheminImage" class="card-img-top">
                    <div class="card-body">
                        <h5 class="card-title">@plats.Nom</h5>
                        <!--Consigne : Mettre tous les champs; C'est quoi, tous les champs?-->
                        <p class="card-text">@plats.Prix $</p>
                        <p class="card-text">@plats.Categorie</p>
                        <a href="Views/plats/details?id=@plats.Id" class="btn btn-primary">Go somewhere</a>
                    </div>
                </div>
            </td>
        }
    </tr>
</table>