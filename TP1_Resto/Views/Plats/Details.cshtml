@using TP1_Resto.ViewModels.Plats

@model PlatDetailsVM
@{
    ViewData["Title"] = Model.plat.Nom;
}

<div class="card">
    <img src="@Model.plat.CheminImage" class="card-img-top" alt="Image de @Model.plat.Nom">
    <div class="card-body">
        <h5 class="card-title">@Model.plat.Nom</h5>
        <p class="card-text">@Model.plat.Prix</p>
        <p class="card-text">@Model.plat.Categorie</p>
        <a href="Plats/Index" class="btn btn-primary">Retour à la liste</a>
    </div>
</div>