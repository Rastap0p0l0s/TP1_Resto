@using TP1_Resto.ViewModels.Plats

@model PlatVM
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Plats";
}

<div class="dropdown">
    @if(Model.selectedCategory==null){
        <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            Catégories
        </button>  
    }else{
        <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            @Model.selectedCategory
        </button>
        <a class="btn btn-info" asp-controller="Plats" asp-action="Index">Retirer le filtre</a>
    }
    <ul class="dropdown-menu" >
        @foreach(string categ in Model.categories)
        {
            <li><a class="dropdown-item" asp-controller="Plats" asp-action="@categ">@categ</a></li>
        }
    </ul>
</div>
<ul class="list-group">
    @foreach(Plat plat in Model.plats)
    {
        <li class="list-group-item row d-flex">
            <p class="col-md-11">@plat.Nom</p>
            <a href="Plat/details/@plat.Id" class="col-md-1 btn btn-outline-dark">Détails</a>
        </li>  
    }
</ul>