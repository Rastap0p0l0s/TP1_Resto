@using TP1_Resto.ViewModels.Accueil

@model AccueilVM
@{
    ViewData["Title"] = "Acceuil";
}

<h4>Meilleurs restaurants</h4>
<table>
    <tr>
        @foreach (Restaurant resto in Model.MeilleursRestos)
        {
            <td>
                <div class="card" style="width: 18rem;">
                    <div class="card-body">
                        <h5 class="card-title">@resto.Nom</h5>
                        <p class="card-text">@resto.Cuisine</p>
                        <p class="card-text">@resto.Note</p>
                    </div>
                </div>
            </td>
        }
    </tr>
</table>

<!--Plats-->
<h4>Plats les moins chers</h4>
<table>
    <tr>
        @foreach (Plat plat in Model.MeilleurPlats)
        {
            <td>
                <div class="card" style="width: 18rem;">
                    <img src="@plat.CheminImage" class="card-img-top">
                    <div class="card-body">
                        <h5 class="card-title">@plat.Nom</h5>
                        <p class="card-text">@plat.Prix $</p>
                        <p class="card-text">@plat.Categorie</p>
                        <a href="Plats/details/@plat.Id" class="btn btn-primary">Détails</a>
                    </div>
                </div>
            </td>
        }
    </tr>
</table>
