@using TP1_Resto.ViewModels.Accueil;

@model AccueilVM
@{
    ViewData["Title"] = "Acceuil";
}

<h4>Meilleurs restaurants</h4>
<table>
    <tr>
        @foreach (Restaurant resto in Model.MeilleursRestos)
        {
            <td>
                <div class="card" style="width: 18rem;">
                    <div class="card-body">
                        <h5 class="card-title">@resto.Nom</h5>
                        <p class="card-text">@resto.Cuisine</p>
                        <p class="card-text">@resto.Note</p>
                    </div>
                </div>
            </td>
        }
    </tr>
</table>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<!--Plats-->
<h4>Plats les moins chers</h4>
<table>
    <tr>
        @foreach (Plat plats in Model.MeilleurPlats)
        {
            <td>
                <div class="card" style="width: 18rem;">
                    <img src="@plats.CheminImage" class="card-img-top">
                    <div class="card-body">
                        <h5 class="card-title">@plats.Nom</h5>
                        <!--Consigne : Mettre tous les champs; C'est quoi, tous les champs?-->
                        <p class="card-text">@plats.Prix $</p>
                        <p class="card-text">@plats.Categorie</p>
                        <a href="Views/plats/details?id=@plats.Id" class="btn btn-primary">Go somewhere</a>
                    </div>
                </div>
            </td>
        }
    </tr>
</table>
